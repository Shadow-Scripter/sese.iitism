generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Purchase {
  id          String   @id @default(cuid())
  userEmail   String
  eventId     String
  purchasedAt DateTime @default(now())

  @@unique([userEmail, eventId])
}
